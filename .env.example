# Registry a cui gli agenti si registrano all'avvio
REGISTRY_URL=http://localhost:8000

# LLM con API compatibile OpenAI (lasciare vuoto LLM_BASE_URL per lavorare senza LLM)
# vLLM:   LLM_BASE_URL=http://localhost:8000/v1   (attenzione: cambiate porta, la 8000 è del registry)
# Ollama: LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=gemma-4
LLM_API_KEY=
LLM_TEMPERATURE=0.3

# Interoperabilità
# Segreto condiviso tra gateway e agenti (firma dei permessi dei team). Generatelo con: python -c "import secrets;print(secrets.token_hex(16))"
MACH_GATEWAY_SECRET=
MACH_GATEWAY_CONFIG=gateway/config.example.json
# Se impostato, serve per registrare agenti nel namespace "mach:"
MACH_REGISTRY_TOKEN=
# Ogni quanti secondi il registry riaggiorna gli indici degli altri team (0 = solo a mano)
MACH_REGISTRY_SYNC_S=0
# API key dei team esterni (riferite da gateway/config.example.json)
TEAM_B_API_KEY=

# NANDA (nodo di Milano)
NANDA_INDEX_URL=http://localhost:8300
NANDA_EMAIL=
NANDA_PASSWORD=
# Dominio con cui pubblichiamo gli agenti (identificatori urn:air:<dominio>:agent:<nome>)
MACH_PUBLISHER_DOMAIN=team-mach.example
MACH_GATEWAY_PUBLIC_URL=http://localhost:9000
# Chiave Ed25519 per firmare AgentFacts e AgentAddr (creata al primo avvio se manca)
MACH_SIGNING_KEY=gateway_signing_key.pem

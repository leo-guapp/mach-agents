{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mach.local/contracts/1.1/accessibility_data.schema.json",
  "$defs": {
    "AccessResult": {
      "additionalProperties": false,
      "properties": {
        "ref_id": {
          "title": "Ref Id",
          "type": "string"
        },
        "ref_type": {
          "enum": [
            "route",
            "facility",
            "stop"
          ],
          "title": "Ref Type",
          "type": "string"
        },
        "verification": {
          "enum": [
            "verified",
            "partial",
            "unverified"
          ],
          "title": "Verification",
          "type": "string"
        },
        "features": {
          "$ref": "#/$defs/Features"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "last_verified": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Verified"
        }
      },
      "required": [
        "ref_id",
        "ref_type",
        "verification",
        "features"
      ],
      "title": "AccessResult",
      "type": "object"
    },
    "AdaptedText": {
      "additionalProperties": false,
      "properties": {
        "lang": {
          "pattern": "^[a-z]{2}$",
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "easy_read": {
          "default": true,
          "title": "Easy Read",
          "type": "boolean"
        }
      },
      "required": [
        "lang",
        "text"
      ],
      "title": "AdaptedText",
      "type": "object"
    },
    "Features": {
      "additionalProperties": false,
      "properties": {
        "step_free": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Free"
        },
        "elevator": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevator"
        },
        "accessible_toilet": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Toilet"
        },
        "accessible_parking": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Parking"
        },
        "audio_announcements": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Announcements"
        },
        "tactile_paving": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tactile Paving"
        },
        "language_mediation": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "no",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language Mediation"
        }
      },
      "title": "Features",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Where"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Since"
        }
      },
      "required": [
        "code",
        "severity"
      ],
      "title": "Issue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "results": {
      "items": {
        "$ref": "#/$defs/AccessResult"
      },
      "title": "Results",
      "type": "array"
    },
    "adapted_text": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdaptedText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "results"
  ],
  "title": "AccessibilityData",
  "type": "object"
}

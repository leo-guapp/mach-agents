{
  "public_url": "http://localhost:9000",
  "publisher_domain": "team-mach.example",
  "publisher_name": "Team MACH",
  "signing_key_path": "gateway_signing_key.pem",
  "max_hops": 4,
  "audit_path": "gateway_audit.jsonl",
  "agents": [
    {
      "name": "accessibility",
      "agent_id": "mach:accessibility",
      "upstream": "http://localhost:8003"
    },
    {
      "name": "mobility",
      "agent_id": "mach:mobility",
      "upstream": "http://localhost:8002"
    },
    {
      "name": "healthcare",
      "agent_id": "mach:healthcare",
      "upstream": "http://localhost:8001",
      "published_skills": [
        "orienta",
        "cerca_disponibilita",
        "prenota"
      ]
    },
    {
      "name": "environment",
      "agent_id": "mach:environment",
      "upstream": "http://localhost:8004"
    }
  ],
  "teams": [
    {
      "team": "team-demo",
      "api_key": "demo-key-cambiami",
      "rate_per_min": 120,
      "scopes": [
        "mach:accessibility:*",
        "mach:mobility:*",
        "mach:healthcare:*",
        "mach:environment:*"
      ]
    },
    {
      "team": "team-b",
      "api_key_env": "TEAM_B_API_KEY",
      "rate_per_min": 60,
      "scopes": [
        "mach:accessibility:*",
        "mach:healthcare:orienta",
        "mach:healthcare:prenota"
      ]
    }
  ]
